# Copy this file to .env and replace the two example values.
# Never commit the completed .env file because it contains a password.
POSTAL_USERNAME=your_username
POSTAL_PASSWORD=your_password

# Scheduled execution should normally run without displaying Chrome.
POSTAL_HEADLESS=true

# Optional: change where downloaded ZIP reports are saved.
# POSTAL_DOWNLOAD_DIR=C:\Users\your.name\Downloads

# Optional Talend delivery. The scheduled Windows account needs share access.
POSTAL_COPY_TO_TALEND=false
POSTAL_TALEND_TRIGGER_DIR=\\FILE-SRV01\epa_files\EpaSyn2\Talend_Triggers

# Optional: change where copy and scheduled-run logs are saved.
# POSTAL_LOG_DIR=C:\AutomationProcess\ReportAutomation\logs

# Optional: use a fixed date for testing; normal runs use today's date.
# POSTAL_REFERENCE_DATE=2026-10-20

